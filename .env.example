# Copy this template to .env. Keep credentials and personal overrides local.
NODE_ENV=development
PORT=3000

# Cloud SQL development settings.
# For database access, run npm run db:env before creating a manual .env.local.
# The helper retrieves the password from Secret Manager and writes DATABASE_URL.
GCP_PROJECT_ID=sfsu-hackathon-2026
CLOUD_SQL_CONNECTION_NAME=sfsu-hackathon-2026:us-west2:sfhacksxgdg2026-db
DB_NAME=timeline
DB_USER=timeline
DB_HOST=127.0.0.1
DB_PORT=5433
DB_PASSWORD_SECRET=sfhacksxgdg2026-db-password

# Required for docker compose. Compose reads this from .env.
# It sets the Postgres password and the app's PGPASSWORD.
# The app URL stays postgresql://rss@postgres:5432/rss with no password in it.
# Postgres applies this password only when the data volume is first created.
POSTGRES_PASSWORD=replace-with-a-local-database-password

# PostgreSQL tables initialize at startup whenever a database is configured.
# Set this for a Postgres server you run yourself. Docker Compose supplies its own URL.
# DATABASE_URL=postgresql://username:password@localhost:5432/sfhacksxgdg2026

# Cloud Run: cloudbuild.yaml attaches this instance and injects DB_PASSWORD from Secret Manager.
# INSTANCE_CONNECTION_NAME=sfsu-hackathon-2026:us-west2:sfhacksxgdg2026-db
# DB_PASSWORD=replace-with-a-database-password
# INSTANCE_CONNECTION_NAME takes precedence over DATABASE_URL and uses /cloudsql sockets.

# RSS starts alongside the web server whenever PostgreSQL is configured.
# Typesense indexing is optional; set its URL and API key to enable search syncing.
# TYPESENSE_URL=http://localhost:8108
# TYPESENSE_API_KEY=replace-with-a-typesense-admin-key
# TYPESENSE_COLLECTION=timeline_entries
# RSS_POLL_SECONDS=3600
# RSS_MAX_WORKERS=10
# FEEDS_FILE=rss-builder/feeds.json
# Set false to disable RSS, or true to require database credentials at startup.
# RSS_ENABLED=true

# Gemma Cloud Run service, configured by scripts/setup-gemma.sh.
# GEMMA_URL=https://YOUR-GEMMA-SERVICE.run.app
# GEMMA_MODEL=google/gemma-4-31B-it
# GEMMA_TIMEOUT_MS=900000
# Cloud Run obtains an identity token automatically from its service account.
# For local/Cloud Shell commands, export GEMMA_ID_TOKEN using gcloud auth print-identity-token.
# Keep identity tokens out of committed files.

# Optional email delivery settings for future application features.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=user@example.com
# SMTP_PASSWORD=replace-with-an-smtp-password
# SMTP_FROM=user@example.com

# Generate article topics/summaries and daily topic bullets in the background.
# Requires the private GEMMA_URL service and runtime IAM invoker access above.
SUMMARIES_ENABLED=false
