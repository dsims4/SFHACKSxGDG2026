# The index page runs with these defaults even without a .env file.
NODE_ENV=development
PORT=3000

# RSS starts alongside the web server when DATABASE_URL and TYPESENSE_API_KEY are set.
# DATABASE_URL=postgresql://username:password@localhost:5432/sfhacksxgdg2026
# TYPESENSE_URL=http://localhost:8108
# TYPESENSE_API_KEY=replace-with-a-typesense-admin-key
# TYPESENSE_COLLECTION=timeline_entries
# RSS_POLL_SECONDS=600
# RSS_MAX_WORKERS=10
# FEEDS_FILE=rss-builder/feeds.json
# Set false to disable RSS, or true to require its credentials at startup.
# RSS_ENABLED=true

# Optional email delivery settings for future application features.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=user@example.com
# SMTP_PASSWORD=replace-with-an-smtp-password
# SMTP_FROM=user@example.com
