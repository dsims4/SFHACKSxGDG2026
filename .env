# Shared development settings. Put passwords and personal overrides in .env.local.
NODE_ENV=development
PORT=3000

# Run npm run db:env to retrieve credentials, then start the Cloud SQL Auth Proxy.
GCP_PROJECT_ID=sfsu-hackathon-2026
CLOUD_SQL_CONNECTION_NAME=sfsu-hackathon-2026:us-west2:sfhacksxgdg2026-db
DB_NAME=timeline
DB_USER=timeline
DB_HOST=127.0.0.1
DB_PORT=5433
DB_PASSWORD_SECRET=sfhacksxgdg2026-db-password
