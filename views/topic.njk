{% extends "layouts/base.njk" %}
{% block body_class %}news-page{% endblock %}
{% block content %}
<div class="topic-page">
    <a href="/">← All topics</a>
    <div class="topic-page-title"><h1>{{ topic.topic | capitalize }}</h1><p>{{ topic.date }} · UTC</p></div>
    <section class="topic-general-summary">
        <h2>Topic summary</h2>
        <ul>{% for bullet in topic.summary %}{% if bullet | trim %}<li>{{ bullet }}</li>{% endif %}{% endfor %}</ul>
    </section>
    <section class="topic-stories">
        <h2>Articles</h2>
        {% for article in articles %}
        <article class="news-card story-summary article-card">
            <h3 class="news-card-title">{% if article.link %}<a href="{{ article.link }}" target="_blank" rel="noopener noreferrer">{{ article.title or "Read original article" }}</a>{% else %}{{ article.title or "Untitled article" }}{% endif %}</h3>
            <p class="news-card-meta article-topics">{{ article.topics | join(" · ") }}</p>
            {% if article.summary and article.summary.length %}<ul class="news-card-summary">{% for bullet in article.summary %}{% if bullet | trim %}<li>{{ bullet }}</li>{% endif %}{% endfor %}</ul>
            {% endif %}
            {% if article.images.length %}<div class="article-images">
                {% for image in article.images %}<img src="{{ image }}" alt="Image from the article" loading="lazy" referrerpolicy="no-referrer">{% endfor %}
            </div>{% endif %}
        </article>
        {% else %}<p>No articles are available for this topic yet.</p>{% endfor %}
    </section>
</div>
{% endblock %}
