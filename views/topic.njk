{% extends "layouts/base.njk" %}
{% block body_class %}globe-page{% endblock %}
{% block scripts %}<link rel="stylesheet" href="/css/globe.css">{% endblock %}
{% block theme_control %}{% endblock %}
{% block content %}
<div class="news-home">
    <header class="site-header">
        <a class="wordmark" href="/" aria-label="Newstralizer home"><span class="brand-symbol" aria-hidden="true">✳</span> newstralizer<span class="brand-period">.</span></a>
        <nav aria-label="Main navigation"><a href="/">The World</a><a href="/briefing">Daily Briefing <span aria-hidden="true">↗</span></a></nav>
        {% include "partials/theme-toggle.njk" %}
    </header>
<div class="topic-page">
    <a href="/briefing">← Daily briefing</a>
    <div class="topic-page-title"><p class="topic-label">Topic</p><h1>{{ topic.topic | capitalize }}</h1><p>{{ topic.date }} · UTC</p></div>
    <section class="topic-general-summary">
        <h2>Topic summary</h2>
        <ul>{% for bullet in topic.summary %}{% if bullet | trim %}<li>{{ bullet }}</li>{% endif %}{% endfor %}</ul>
    </section>
    <section class="topic-stories">
        <h2>Articles</h2>
        {% for article in articles %}
        <article class="news-card story-summary article-card">
            <header class="news-card-header">
            <h3 class="news-card-title">{% if article.link %}<a href="{{ article.link }}" target="_blank" rel="noopener noreferrer">{{ article.title or "Read original article" }}</a>{% else %}{{ article.title or "Untitled article" }}{% endif %}</h3>
            <p class="news-card-meta"><span class="article-publisher">{{ article.publisher }}</span> · <time datetime="{{ article.publishedAt }}">{{ article.publishedLabel }} UTC</time></p>
            <p class="article-topics"><span class="topic-label">Topics</span> {% for label in article.topics %}<span class="topic-tag">{{ label | capitalize }}</span>{% endfor %}</p>
            </header>
            {% if article.summary and article.summary.length %}<ul class="news-card-summary">{% for bullet in article.summary %}{% if bullet | trim %}<li>{{ bullet }}</li>{% endif %}{% endfor %}</ul>
            {% endif %}
            {% if article.images.length %}<div class="article-images">
                {% for image in article.images %}<img src="{{ image }}" alt="Image from the article" loading="lazy" referrerpolicy="no-referrer">{% endfor %}
            </div>{% endif %}
        </article>
        {% else %}<p>No articles are available for this topic yet.</p>{% endfor %}
    </section>
</div>
</div>
{% endblock %}
