{% extends "layouts/base.njk" %}
{% block title %}Newstralizer — A world of stories{% endblock %}
{% block body_class %}globe-page{% endblock %}
{% block scripts %}
<link rel="stylesheet" href="/css/globe.css">
<script defer src="/js/globe.bundle.js"></script>
{% endblock %}
{% block content %}
<div class="news-home">
    <header class="site-header">
        <a class="wordmark" href="/" aria-label="Newstralizer home"><span class="brand-symbol" aria-hidden="true">✳</span> newstralizer<span class="brand-period">.</span></a>
        <nav aria-label="Main navigation"><a href="#globe-section" aria-current="page">The world</a><a href="#daily-topics">Daily briefing <span aria-hidden="true">↗</span></a></nav>
        <span class="header-note">A little context. A wider world.</span>
    </header>

    <section id="globe-section" class="globe-section" aria-labelledby="globe-heading">
        <div class="globe-intro">
            <div><p class="eyebrow"><span class="status-dot"></span> A WORLD IN FOCUS</p><h1 id="globe-heading">Every story has a <em>place.</em></h1></div>
            <p class="intro-description">Explore where the news is unfolding.<br>Find the patterns. Follow your curiosity.</p>
        </div>

        <div class="globe-card" id="globe-app" aria-busy="true">
            <div class="globe-toolbar">
                <div class="globe-filters">
                    <label class="select-field"><span>Topic</span><select id="globe-topic"><option value="all">All topics</option></select></label>
                    <label class="select-field"><span>Time period</span><select id="globe-period"><option value="48">Past 48 hours</option><option value="24">Past 24 hours</option></select></label>
                </div>
                <div class="layer-switch" role="group" aria-label="Globe layer"><button type="button" data-layer="heatmap" aria-pressed="true">◉ &nbsp; Heatmap</button><button type="button" data-layer="columns" aria-pressed="false">▥ &nbsp; Columns</button></div>
            </div>

            <div class="globe-body">
                <div class="globe-visual">
                    <div class="globe-view-label"><span class="tiny-cross" aria-hidden="true">+</span> GLOBAL PERSPECTIVE <span class="view-dimension">/ 3D</span></div>
                    <div id="globe-canvas" class="globe-canvas" aria-label="Interactive story globe"></div>
                    <div id="globe-loading" class="globe-loading" role="status">Bringing the world into focus…</div>
                    <div id="globe-tooltip" class="globe-tooltip" hidden></div>
                    <div id="globe-fallback" class="globe-fallback" hidden><strong>The globe is unavailable in this browser.</strong><p>You can still explore every location in the list.</p></div>
                    <div class="globe-controls" role="group" aria-label="Globe camera controls"><button type="button" id="globe-zoom-in" aria-label="Zoom in" title="Zoom in">+</button><button type="button" id="globe-zoom-out" aria-label="Zoom out" title="Zoom out">−</button><span></span><button type="button" id="globe-reset" aria-label="Reset globe view" title="Reset view">⌖</button><button type="button" id="globe-rotate" aria-label="Toggle globe rotation" aria-pressed="false" title="Auto-rotate">↻</button></div>
                    <div class="globe-visual-footer"><span class="globe-instructions">Drag to explore <span>·</span> Scroll to zoom</span><div class="heat-legend"><span id="globe-legend-title">Story density</span><span class="legend-gradient"></span><span>Low → High</span></div></div>
                </div>

                <aside class="globe-sidebar" aria-label="Story locations">
                    <div class="coverage-status"><span class="status-dot"></span><span id="globe-data-status" role="status">Loading coverage</span></div>
                    <div class="globe-stats" aria-live="polite" aria-atomic="true"><div><strong id="globe-story-count">—</strong><span>Labeled stories</span></div><div><strong id="globe-location-count">—</strong><span>Locations</span></div></div>
                    <label class="location-search" for="globe-location"><span>TAKE ME SOMEWHERE</span><select id="globe-location"><option value="">Choose a location</option></select></label>
                    <div class="hotspot-heading"><h2>In the spotlight</h2><span>STORIES</span></div>
                    <div id="globe-locations" class="hotspot-list" aria-label="Locations ranked by story count"></div>
                    <section id="globe-selection" class="location-detail" aria-live="polite"><p class="detail-eyebrow">A CLOSER LOOK</p><h3>A world of perspectives</h3><p>Select a hotspot or location to explore its story labels.</p></section>
                    <div class="globe-source"><label for="globe-source">Data source</label><select id="globe-source"><option value="live">Latest stories</option><option value="demo">Illustrative demo</option></select><p id="globe-data-note">Only labeled stories with a known location appear.</p><button type="button" id="globe-retry" hidden>Retry latest stories ↗</button></div>
                </aside>
            </div>
            <div class="globe-caption"><span><span class="caption-icon" aria-hidden="true">◎</span> One planet. Countless perspectives.</span><span>Geography: <a href="https://www.naturalearthdata.com/about/terms-of-use/" target="_blank" rel="noopener noreferrer">Natural Earth</a> <span class="caption-separator">/</span> Location labels are approximate.</span></div>
        </div>
        <noscript><p class="no-script">Enable JavaScript to explore the interactive globe. Your daily briefing is available below.</p></noscript>
    </section>

    <section id="daily-topics" class="daily-topics" aria-labelledby="daily-heading">
        <div class="daily-heading"><div><p class="eyebrow">BEYOND THE HEADLINES</p><h2 id="daily-heading">Your daily briefing</h2></div><p>The topics shaping the conversation.</p></div>
        <div class="briefing-grid">
        {% for topic in topics %}
        <article class="briefing-card news-card">
            <p class="briefing-date">{{ topic.date }} · UTC</p>
            <p class="topic-label">Topic</p>
            <h3><a href="/topic/{{ topic.id }}">{{ topic.topic | capitalize }} <span aria-hidden="true">↗</span></a></h3>
            <ul>
                {% for bullet in topic.summary %}{% if bullet | trim %}<li>{{ bullet }}</li>{% endif %}{% endfor %}
            </ul>
            <a class="briefing-link" href="/topic/{{ topic.id }}">Read the briefing <span aria-hidden="true">→</span></a>
        </article>
        {% else %}
        <div class="briefing-empty" role="status"><span aria-hidden="true">↗</span><div><h3>Your next perspective is on its way.</h3><p>{{ message or "Topic summaries are being prepared. Explore the globe while your briefing comes together." }}</p></div></div>
        {% endfor %}
        </div>
    </section>
    <footer class="home-footer"><span>newstralizer.</span><p>See the world with a little more context.</p><a href="#globe-section">Back to the world ↑</a></footer>
</div>
{% endblock %}
