{% extends "layouts/base.njk" %}

{% block content %}

<div class="homepage">

    <h1>newstralizer</h1>

    <div class="topics-container">

        {% for topic in topics %}

            <div class="topic-column">

                <div class="topic-title">
                    <a href="/topic/{{ topic.id }}">
                        <h2>{{ topic.title }}</h2>
                    </a>
                </div>

                <div class="topic-summary">
                    <ul>

                        {% for story in topic.stories %}

                            <li>
                                <a href="/story/{{ story.id }}">
                                    {{ story.summary }}
                                </a>
                            </li>

                        {% endfor %}

                    </ul>
                </div>

                <div class="topic-extractions">
                    <h3>Extractions</h3>
                </div>

            </div>

        {% endfor %}

    </div>

</div>

{% endblock %}