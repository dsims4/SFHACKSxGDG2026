{% extends "layouts/base.njk" %}
{% block title %}Daily Briefing — Newstralizer{% endblock %}
{% block body_class %}globe-page{% endblock %}
{% block scripts %}<link rel="stylesheet" href="/css/globe.css">{% endblock %}
{% block theme_control %}{% endblock %}
{% block content %}
<div class="news-home">
    <header class="site-header">
        <a class="wordmark" href="/" aria-label="Newstralizer home"><span class="brand-symbol" aria-hidden="true">✳</span> newstralizer<span class="brand-period">.</span></a>
        <nav aria-label="Main navigation"><a href="/">The World</a><a href="/briefing" aria-current="page">Daily Briefing <span aria-hidden="true">↗</span></a></nav>
        {% include "partials/theme-toggle.njk" %}
    </header>

    <section id="daily-topics" class="daily-topics" aria-labelledby="daily-heading">
        <div class="daily-heading"><div><p class="eyebrow">BEYOND THE HEADLINES</p><h2 id="daily-heading">Your daily briefing</h2></div><p>The topics shaping the conversation.</p></div>
        <form class="briefing-filters" method="get" action="/briefing">
            <input type="hidden" name="all" value="true">
            <details class="topic-filter">
                <summary>Filter topics <span class="topic-filter-count">{% if selectedTopics.length %}{{ selectedTopics.length }} selected{% else %}All topics{% endif %}</span></summary>
                <fieldset>
                    <legend>Show topics</legend>
                    <div class="topic-filter-options" tabindex="0" role="region" aria-label="Topic options">
                        {% for label in availableTopics %}
                        <label><input type="checkbox" name="topic" value="{{ label }}" {% if label in selectedTopics %}checked{% endif %}> {{ label | capitalize }}</label>
                        {% endfor %}
                    </div>
                </fieldset>
                <div class="topic-filter-actions"><button type="submit">Apply filters</button> <a href="/briefing?all=true">Show all topics</a></div>
            </details>
        </form>
        <div class="briefing-grid">
        {% for topic in topics %}
        <article class="briefing-card news-card">
            <p class="briefing-date">{{ topic.date }} · UTC</p>
            <p class="topic-label">Topic</p>
            <h3><a href="/topic/{{ topic.id }}">{{ topic.topic | capitalize }} <span aria-hidden="true">↗</span></a></h3>
            <ul>
                {% for bullet in topic.summary %}{% if loop.index <= 3 %}{% if bullet | trim %}<li>{{ bullet }}</li>{% endif %}{% endif %}{% endfor %}
            </ul>
            <a class="briefing-link" href="/topic/{{ topic.id }}">Read the briefing <span aria-hidden="true">→</span></a>
        </article>
        {% else %}
        <div class="briefing-empty" role="status"><span aria-hidden="true">↗</span><div><h3>Your next perspective is on its way.</h3><p>{{ message or "No summaries match these topics yet. Choose other topics or check back shortly." }}</p></div></div>
        {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
